{
  "manifest_version": 3,
  "name": "CF Focus — AI Blocker for Competitive Programming",
  "version": "1.1.0",
  "description": "Blocks AI chatbots while you practice on Codeforces, LeetCode, AtCoder & more. Earned AI unlock, hardcore sessions, streaks, stats.",
  "minimum_chrome_version": "114",
  "permissions": [
    "tabs",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://*.chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://claude.ai/*",
    "*://*.claude.ai/*",
    "*://gemini.google.com/*",
    "*://copilot.microsoft.com/*",
    "*://*.copilot.microsoft.com/*",
    "*://bing.com/*",
    "*://*.bing.com/*",
    "*://perplexity.ai/*",
    "*://*.perplexity.ai/*",
    "*://phind.com/*",
    "*://*.phind.com/*",
    "*://poe.com/*",
    "*://*.poe.com/*",
    "*://deepseek.com/*",
    "*://*.deepseek.com/*",
    "*://grok.com/*",
    "*://*.grok.com/*",
    "*://mistral.ai/*",
    "*://*.mistral.ai/*",
    "*://you.com/*",
    "*://*.you.com/*",
    "*://cohere.com/*",
    "*://*.cohere.com/*",
    "*://huggingface.co/*",
    "*://*.huggingface.co/*",
    "*://aistudio.google.com/*",
    "*://writesonic.com/*",
    "*://*.writesonic.com/*",
    "*://x.ai/*",
    "*://*.x.ai/*",
    "*://character.ai/*",
    "*://*.character.ai/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "toggle-snooze": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Toggle snooze (pause AI blocking temporarily)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
